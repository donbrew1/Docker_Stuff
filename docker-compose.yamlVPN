services:
  vpn:
    container_name: vpn
    image: dperson/openvpn-client:latest
    cap_add:
      - net_admin # required to modify network interfaces
    restart: always #unless-stopped
    devices:
      - /dev/net/tun:/dev/net/tun
    volumes:
      - /dev/net:/dev/net:z # tun device
      - ${ROOT}/config/vpn:/vpn # OpenVPN configuration
    security_opt:
      - label:disable
    ports:
      - 8112:8112 # port for deluge web UI to be reachable from local networ
      - 8080:8080 # qbittorrent 
      - 6881:6881
      - 6881:6881/udp
      - 58846:58846 #optional     
      #- 9117:9117 # jacket    
    command: '-f "" -r 192.168.1.0/24' # enable firewall and route local network traffic
    
  deluge:
    container_name: deluge
    image: linuxserver/deluge:latest
   # depends_on: 
    # - vpn   
    restart: always # unless-stopped
    network_mode: service:vpn # run on the vpn network
    environment:
      - PUID=${PUID} # default user id, defined in .env
      - PGID=${PGID} # default group id, defined in .env
      - TZ=${TZ} # timezone, defined in .env
    volumes:
      - ${ROOT}/downloads/temp:/media/downloads/temp # downloads folder
      - ${ROOT}/config/deluge:/config # config files
      - ${ROOT}/downloads/finished:/media/downloads/finished
      - /media/downloads/radarr:/media/downloads/radarr

  qbittorrent:
    container_name: qbittorrent
    image: lscr.io/linuxserver/qbittorrent:latest
    #depends_on: 
     # - vpn
    network_mode: service:vpn
    environment:
      - PUID=${PUID} # default user id, defined in .env
      - PGID=${PGID} # default group id, defined in .env
      - TZ=${TZ} # timezone, defined in .env
      - WEBUI_PORT=8080
    volumes:
      - ${ROOT}/config/qbittorrent:/config
      - /media/downloads:/media/downloads # downloads folder 
      - ${ROOT}/downloads:/media/downloads/temp/radarr # downloads folder
    restart: always # unless-stopped


  jackett:
    container_name: jackett
    image: linuxserver/jackett:latest
    restart:  always #unless-stopped
   # network_mode: service:vpn # run on the vpn network
    environment:
      - PUID=${PUID} # default user id, defined in .env
      - PGID=${PGID} # default group id, defined in .env
      - TZ=${TZ} # timezone, defined in .env
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - ${ROOT}/downloads/torrent-blackhole:/downloads # place where to put .torrent files for manual download
      - ${ROOT}/config/jackett:/config # config files
    ports:
      - 9117:9117 # jacket 
      
  sonarr:
    container_name: sonarr
    image: linuxserver/sonarr:latest
    restart: always # unless-stopped
   #network_mode: service:vpn # run on the vpn network
    environment:
      - PUID=${PUID} # default user id, defined in .env
      - PGID=${PGID} # default group id, defined in .env
      - TZ=${TZ} # timezone, defined in .env
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - ${ROOT}/config/sonarr:${ROOT}/config/sonarr # config files
      - /media/TVShows:/media/TVShows # tv shows folder
      - ${ROOT}/downloads:/media/downloads # download folder
      #- ${ROOT}/complete:/media/downloads/sonarr
      - ${ROOT}/complete:/media/downloads/finished
    ports:
      - 8989:8989 # sonarr
         
  radarr:
    container_name: radarr
    image: linuxserver/radarr:latest
    restart: always # unless-stopped
   # network_mode:  service:vpn # run on the vpn network
    environment:
      - PUID=${PUID} # default user id, defined in .env
      - PGID=${PGID} # default group id, defined in .env
      - TZ=${TZ} # timezone, defined in .env
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - ${ROOT}/config/radarr:/media/config/radarr # config files
      - /media/Movies:/media/Movies # movies folder
      - ${ROOT}/downloads/radarr:/media/downloads/radarr # download folder
      - /media/downloads/temp:/media/downloads/temp
      - ${ROOT}/complete:/media/downloads/finished
    ports:
      - 7878:7878 # radar\

  prowlarr:
    image: lscr.io/linuxserver/prowlarr:latest
    container_name: prowlarr
    environment:
      - PUID=${PUID} # default user id, defined in .env
      - PGID=${PGID} # default group id, defined in .env
      - TZ=${TZ} # timezone, defined in .env
    volumes:
      - ${ROOT}/config/prowlarr/data:/config  
    restart: always # unless-stopped
    ports:
      - 9696:9696 # prowlarr

  flaresolverr:
    # DockerHub mirror flaresolverr/flaresolverr:latest
    image: ghcr.io/flaresolverr/flaresolverr:latest
    container_name: flaresolverr
    environment:
      - LOG_LEVEL=${LOG_LEVEL:-info}
      - LOG_HTML=${LOG_HTML:-false}
      - CAPTCHA_SOLVER=${CAPTCHA_SOLVER:-none}
      - TZ=${TZ}
    restart: always # unless-stopped 
    ports:
       - 8191:8191 # flaresolverr
       
  jellyfin:
    image: lscr.io/linuxserver/jellyfin:latest
    container_name: jellyfin
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
      #- JELLYFIN_PublishedServerUrl=http://192.168.0.5 #optional
    volumes:
      - ${ROOT}/config/jellyfin/library:/config
      - /path/to/tvseries:/media/TVShows
      - /path/to/movies:/media/Movies
    ports:
      - 8096:8096
   #   - 8920:8920 #optional
    #  - 7359:7359/udp #optional
     # - 1900:1900/udp #optional
    restart: always # unless-stopped       